# Copy to .env and fill in real values:  cp .env.example .env
# This service is a pure RabbitMQ consumer + SMTP mailer (no HTTP server).

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Local Docker Desktop RabbitMQ accepts guest/guest over localhost.
# In production these must be a real user (the docker network rejects guest).
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Email / SMTP (Mailtrap sandbox by default) ---
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
